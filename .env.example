# Set a descriptive User-Agent with a real contact channel before running.
FLATNAMA_USER_AGENT=PunePropertyResearchBot/0.1 (contact: your-email@example.com)
FLATNAMA_DELAY_SECONDS=2.5
FLATNAMA_TIMEOUT_SECONDS=25
FLATNAMA_MAX_RETRIES=2
# Optional: only set to 1 after FlatNama has explicitly authorized bulk extraction.
FLATNAMA_BULK_PERMISSION_CONFIRMED=0
DATABASE_URL=postgresql://property_user:change_me@localhost:5432/pune_property
